# ============================================================
# SKY RESERVATION AI — Environment Variables
# Copy this file to .env.local for local development.
# All variables marked [REQUIRED] must be set before deployment.
# ============================================================

# ─── Supabase [REQUIRED] ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Server-only — never expose to client

# ─── App [REQUIRED] ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ─── Rate Limiting — Upstash Redis [REQUIRED in production] ──
# Without these, rate limiting falls back to in-memory (dev only).
# Get credentials at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ─── OpenAI [REQUIRED] ───────────────────────────────────────
# Used for: WhatsApp AI responses, lead scoring, analytics insights.
OPENAI_API_KEY=sk-...

# ─── Vapi — Voice AI [REQUIRED if using voice channel] ───────
# Get credentials at: https://vapi.ai/dashboard
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=   # HMAC secret — fail-closed if missing (returns 503)

# ─── Meta / WhatsApp Business [REQUIRED if using WhatsApp] ───
# Set up at: https://developers.facebook.com/apps/
META_WHATSAPP_TOKEN=       # Bearer token for Graph API calls
META_WHATSAPP_PHONE_ID=    # Phone Number ID from WhatsApp Business settings
META_WEBHOOK_VERIFY_TOKEN= # Arbitrary secret for webhook verification handshake
META_APP_SECRET=           # App Secret — HMAC secret for webhook signatures (fail-closed)

# ─── Stripe [REQUIRED for Stripe billing] ────────────────────
# Get credentials at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...        # Use sk_test_... for development
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...      # From: stripe listen --forward-to localhost:3000/api/billing/webhooks/stripe

# Stripe Price IDs (create products in Stripe Dashboard first)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...

# ─── MercadoPago [REQUIRED for LATAM billing] ────────────────
# Get credentials at: https://www.mercadopago.com.ar/developers
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# ─── n8n Automations [OPTIONAL] ──────────────────────────────
# Only required if using the Automations feature with n8n.
# Per-tenant webhook URLs are stored in tenants.settings.n8n_webhooks.
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook
